<Window x:Class="FloatTrans.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay" WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">
    <Canvas x:Name="Layer" Background="Transparent">
        <Rectangle x:Name="Rect" Stroke="#FF1E9FFF" StrokeThickness="1.5" Fill="#331E9FFF" Visibility="Collapsed"/>
        <Line x:Name="CrossH" Stroke="#FFFF3B30" StrokeThickness="1.5" Visibility="Collapsed"/>
        <Line x:Name="CrossV" Stroke="#FFFF3B30" StrokeThickness="1.5" Visibility="Collapsed"/>
        <Ellipse x:Name="CrossDot" Width="6" Height="6" Fill="#FFFF3B30" Visibility="Collapsed"/>
    </Canvas>
</Window>
