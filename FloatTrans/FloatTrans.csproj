<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net8.0-windows10 TFM: 直连 Windows.Media.Ocr 等 WinRT API,无需额外 NuGet -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 引入 System.Drawing / System.Windows.Forms,用于 CopyFromScreen 截图 -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FloatTrans</AssemblyName>
    <RootNamespace>FloatTrans</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <!-- 轻量发布:框架依赖 + 单文件(exe 约 1-3MB,需用户机器装有 .NET 8 Desktop Runtime) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- .NET 8 推荐:用项目属性而非 manifest 配置 DPI(System DPI awareness) -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- 消除 WPF(System.Windows)与 WinForms/System.Drawing 的 Point/Application/Clipboard 类型歧义 -->
    <Using Include="System.Windows.Point" Alias="Point" />
    <Using Include="System.Windows.Application" Alias="Application" />
    <Using Include="System.Windows.Clipboard" Alias="Clipboard" />
    <Using Include="System.Windows.MessageBox" Alias="MessageBox" />
  </ItemGroup>

</Project>
