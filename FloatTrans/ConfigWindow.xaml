<Window x:Class="FloatTrans.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置百度翻译 API" Height="360" Width="480"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#FFF6F8FA">
    <StackPanel Margin="16">
        <TextBlock Text="百度翻译 API 配置" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
        <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
            未检测到可用的翻译 API。请到
            <Hyperlink NavigateUri="https://fanyi-api.baidu.com/" RequestNavigate="OpenUrl">fanyi-api.baidu.com</Hyperlink>
            注册并开通「通用翻译 API」(免费标准版),获取 APP ID 和密钥后填入下方。
        </TextBlock>
        <TextBlock Text="APP ID" Margin="0,4,0,2"/>
        <TextBox x:Name="AppIdBox" FontSize="13"/>
        <TextBlock Text="密钥 Secret" Margin="0,8,0,2"/>
        <TextBox x:Name="SecretBox" FontSize="13"/>
        <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保存并测试" Click="SaveTestClick" Padding="14,5" Margin="0,0,8,0"/>
            <Button Content="稍后" Click="LaterClick" Padding="14,5" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
