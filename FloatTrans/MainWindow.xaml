<Window x:Class="FloatTrans.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloatTrans" Height="60" Width="60"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">
    <Grid>
        <Ellipse x:Name="Ball" Width="54" Height="54" Stroke="#FF1E9FFF" StrokeThickness="1.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#992FB8FF" Offset="0"/>
                    <GradientStop Color="#660F6FC8" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.4"/>
            </Ellipse.Effect>
        </Ellipse>
        <TextBlock Text="译" Foreground="White" FontWeight="Bold" FontSize="20"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
</Window>
